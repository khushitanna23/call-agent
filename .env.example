# ==============================================================================
# VEDANCO AI — WHITE-LABEL VOICE AI & RECEPTIONIST SAAS
# MULTI-TENANT AGENCY & SUB-ACCOUNT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://voice.vedanco.ai

# ------------------------------------------------------------------------------
# 2. DATABASE & MULTI-TENANCY STORAGE (PostgreSQL / Supabase & MongoDB)
# ------------------------------------------------------------------------------
# Supabase / PostgreSQL Connection with Row Level Security (RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# MongoDB Atlas (Hybrid Document & Call Turn Store)
MONGO_URI=mongodb+srv://admin:your_password@cluster0.mongodb.net/vedanco_ai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & MULTI-TENANT JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_agency_jwt_signing_key_min_64_characters_long
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=32_byte_aes_key_for_encrypting_client_carrier_tokens

# Google OAuth 2.0 Identity Services (GIS)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 4. TELEPHONY & MASTER CARRIER TRUNK (Twilio / Telnyx)
# ------------------------------------------------------------------------------
# Master Twilio Credentials used for purchasing numbers and global voice pool
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_master_twilio_auth_token
TWILIO_PHONE_NUMBER=+18558332626
TWILIO_WEBHOOK_URL=https://api.vedanco.ai/api/twilio/voice

# ------------------------------------------------------------------------------
# 5. VOICE AI ENGINE (Vapi & Real-Time Orchestration)
# ------------------------------------------------------------------------------
# Primary Outbound & Inbound Voice Engine
VAPI_API_KEY=your_vapi_private_api_key
VAPI_ASSISTANT_ID=your_sarah_ai_assistant_uuid
VAPI_PHONE_NUMBER_ID=your_vapi_registered_phone_uuid
VAPI_WEBHOOK_SECRET=your_vapi_webhook_signing_secret

# ------------------------------------------------------------------------------
# 6. LLM & KNOWLEDGE BASE RAG (OpenAI / Anthropic / Google Gemini)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your_claude_api_key
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 7. HIGH-FIDELITY SYNTHETIC VOICES (ElevenLabs & Deepgram)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # Sarah (Professional & Warm)
DEEPGRAM_API_KEY=your_deepgram_stt_api_key

# ------------------------------------------------------------------------------
# 8. STRIPE CONNECT & BILLING MARKUP ENGINE
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_REFILL_PRICE_500=price_1QXXXXXXXX
STRIPE_REFILL_PRICE_1000=price_1QYYYYYYYY
STRIPE_REFILL_PRICE_2500=price_1QZZZZZZZZ

# ------------------------------------------------------------------------------
# 9. WHITE-LABEL BRANDING & CUSTOM DOMAINS (CNAME / SSL)
# ------------------------------------------------------------------------------
AGENCY_DEFAULT_CNAME_TARGET=cname.vedanco.ai
CLOUDFLARE_API_TOKEN=your_cloudflare_custom_hostname_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
RESEND_API_KEY=re_your_resend_email_api_key
FROM_EMAIL=dispatch@vedanco.ai
