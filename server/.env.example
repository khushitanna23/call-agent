# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/vedanco_ai

# JWT Authentication
JWT_SECRET=vedanco_super_secret_jwt_key_2026_prod_grade_token
JWT_EXPIRES_IN=7d

# AI Providers (Optional - Mock engine will be used if keys are not provided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voice Providers (Optional - Mock provider handles voice simulation if not set)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Text-to-Speech (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
